{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-agent/verifier_output.json",
  "title": "VerifierOutput",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "label"],
        "properties": {
          "claim_id": { "type": "string" },
          "label": {
            "type": "string",
            "enum": ["supported", "unsupported", "conflicting", "uncertain"]
          },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
